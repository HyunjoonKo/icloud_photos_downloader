FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml .
COPY src/ src/

RUN pip install --no-cache-dir setuptools \
    && pip install --no-cache-dir \
    requests==2.32.3 \
    schema==0.7.7 \
    tqdm==4.67.1 \
    piexif==1.1.3 \
    "urllib3==1.26.20" \
    typing_extensions==4.14.0 \
    Flask==3.1.1 \
    waitress==3.0.2 \
    tzlocal==5.3.1 \
    pytz==2025.2 \
    certifi==2025.4.26 \
    keyring==25.6.0 \
    keyrings-alt==5.0.2 \
    srp==1.0.22 \
    && pip install --no-cache-dir -e .

ENV TZ=Asia/Seoul

ENTRYPOINT ["icloudpd"]
